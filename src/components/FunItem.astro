---
import type { Work } from "../lib/content";
interface Props {
  item: Work;
}
const d = Astro.props.item.data;
const href = d.links?.find((l) => l.href)?.href ?? "https://github.com/ngquyduc";
---

<a class="row-link flex items-center gap-3.5 border-b border-line py-3" href={href}>
  <span aria-hidden="true" class="size-12 shrink-0 rounded-md border border-line bg-sunken"></span>
  <span class="flex min-w-0 flex-auto flex-col">
    <b class="text-base font-semibold">{d.title}</b>
    <span class="mono text-xs text-muted">{d.stack.join(" · ")}</span>
  </span>
  <span class="arrow" aria-hidden="true">→</span>
</a>
