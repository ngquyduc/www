---
// Figure with numbered caption. With no image, renders the striped slot (§5.10).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Placeholder from "./Placeholder.astro";
interface Props {
  n?: number;
  src?: ImageMetadata;
  alt?: string;
  label?: string;
  ratio?: string;
  wide?: boolean;
}
const { n, src, alt, label: slotText, ratio = "16/9", wide = false } = Astro.props;
---

<figure class:list={["my-6", wide && "bleed mx-auto max-w-[48rem]"]}>
  {
    src && alt ? (
      <Image src={src} alt={alt} class="h-auto w-full rounded-md border border-line" />
    ) : (
      <Placeholder block class="!p-4">
        <span class="kicker grid w-full place-items-center text-center" style={`aspect-ratio:${ratio}`}>{slotText ?? "Figure slot"}</span>
      </Placeholder>
    )
  }
  {
    Astro.slots.has("default") && (
      <figcaption class:list={["mt-2 text-sm text-muted", wide && "mx-auto max-w-prose"]}>
        {n !== undefined && <>Fig. {n} · </>}
        <slot />
      </figcaption>
    )
  }
</figure>
