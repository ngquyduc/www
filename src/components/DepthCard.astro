---
// Depth card, Work tier B (§5.7). Links without href render as plain text (private code).
import type { Work } from "../lib/content";
import { workHref } from "../lib/content";
import PhText from "./PhText.astro";
import Tag from "./Tag.astro";

interface Props {
  item: Work;
}
const { item } = Astro.props;
const d = item.data;
const contextLabel = { personal: "Side project", coursework: "Coursework", employment: "Work", internship: "Internship" };
const links = [...(d.hasPage ? [{ label: "Depth page", href: workHref(item) }] : []), ...(d.links ?? [])];
---

<article class="flex flex-col gap-3 rounded-md border border-line-strong bg-raised p-5">
  <div class="flex flex-wrap items-center gap-1.5">
    <Tag variant="filled">Depth</Tag>
    {d.context ? <Tag>{contextLabel[d.context]}</Tag> : <Tag variant="placeholder">Personal or coursework?</Tag>}
  </div>
  <h3 class="text-[21px] leading-[1.25] font-semibold tracking-[-0.01em]">{d.title}</h3>
  <p class="text-[15px] text-muted"><PhText text={d.summary} /></p>
  <p class="mono text-xs text-subtle">{d.stack.join(" · ")}</p>
  {d.coursework && <p class="text-[13px] text-muted"><PhText text={`${d.coursework.module} · with ${d.coursework.coAuthors.join(", ")}`} /></p>}
  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1.5 border-t border-line pt-3 text-sm">
    {
      links.map((l) =>
        l.href ? (
          <a href={l.href} class="font-medium">{l.label}<span class="sr-only">: {d.title}</span></a>
        ) : (
          <span class="mono text-xs text-subtle">{l.label}</span>
        ),
      )
    }
  </div>
</article>
