---
// Featured row (§5.5): the whole row is one link; arrow nudges on hover.
// Used on Home for both the Experience and the Projects sections.
import type { Work } from "../lib/content";
import { when, workHref } from "../lib/content";
import PhText from "./PhText.astro";
import Tag from "./Tag.astro";

interface Props {
  item: Work;
  n: number;
}
const { item, n } = Astro.props;
const d = item.data;
const href = d.hasPage ? workHref(item) : (d.links?.find((l) => l.href)?.href ?? "/work");
const isJob = d.tier === "experience";
const meta = d.featuredMeta ?? (isJob ? `${d.role} · ${when(d.start, d.end)}` : d.stack.join(" · "));
const first = d.metrics?.[0];
const metric = d.featuredMetric ?? (first ? (first.label ? `${first.value} ${first.label}` : first.value) : "");
const contextLabel = {
  personal: "Side project",
  coursework: "Coursework",
  employment: "Work",
  internship: "Internship",
  programme: "Programme",
};
// Coursework and programme projects keep their credit line (§2.3).
const credit = d.coursework
  ? `${d.coursework.module} · with ${d.coursework.coAuthors.join(", ")}`
  : d.programme
    ? `${d.programme.name} · ${d.programme.note}`
    : "";
---

<a class="row-link flex flex-wrap items-baseline gap-x-6 gap-y-2 border-b border-line py-6" href={href}>
  <span class="mono w-8 shrink-0 text-[13px] text-subtle max-md:hidden">{String(n).padStart(2, "0")}</span>
  <span class="flex min-w-0 flex-[1_1_380px] flex-col gap-1">
    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
      <span class="text-xl font-semibold tracking-[-0.01em]">{d.title}</span>
      <span class="mono text-xs text-muted"><PhText text={meta} /></span>
    </span>
    <span class="max-w-prose text-base text-muted"><PhText text={d.featuredSummary ?? d.summary} /></span>
    {credit && <span class="text-[13px] text-muted"><PhText text={credit} /></span>}
  </span>
  <span class="flex shrink-0 flex-wrap items-center gap-2">
    {
      isJob ? (
        <Tag variant="filled">Experience</Tag>
      ) : (
        <>
          <Tag variant="filled">Depth</Tag>
          {d.context ? <Tag>{contextLabel[d.context]}</Tag> : <Tag variant="placeholder">Personal or coursework?</Tag>}
        </>
      )
    }
  </span>
  <span class="mono shrink-0 text-[15px] font-medium md:w-[150px] md:text-right">{metric && <PhText text={metric} />}</span>
  <span class="arrow w-5 shrink-0 max-md:hidden" aria-hidden="true">→</span>
</a>
