---
// Numbered section head (§13.3): "01" numeral, a 40 px title, an optional link on the right, and an
// ink rule that draws in from the left the first time it enters the viewport (`rule`, §13.2).
// Until the observer runs (or with no JS, or under reduced motion) the rule is simply drawn.
interface Props {
  n: string;
  id: string;
  title: string;
  more?: { href: string; label: string };
  /** A short mono aside on the right, when there is no link. */
  note?: string;
}
const { n, id, title, more, note } = Astro.props;
---

<div class="shead" data-io>
  <span class="mono text-[14px] text-accent">{n}</span>
  <h2 id={id} class="text-section">{title}</h2>
  {more && <a href={more.href} class="ml-auto text-[15px]">{more.label} <span aria-hidden="true">→</span></a>}
  {!more && note && <span class="mono ml-auto text-xs text-subtle">{note}</span>}
</div>

<style>
  .shead {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    padding-bottom: 14px;
  }
  .shead::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--color-ink);
    transform-origin: left;
  }
  .shead.io-wait::after {
    transform: scaleX(0);
  }
  .shead.io-in::after {
    animation: rule 600ms var(--ease-out) both;
  }
</style>
