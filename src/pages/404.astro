---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page was never delivered." noindex>
  <section class="wrap pt-16 pb-10 md:pt-24">
    <div class="flex flex-wrap items-center gap-x-16 gap-y-10">
      <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4">
        <p class="kicker text-accent">404 · Not found</p>
        <h1 class="text-3xl font-bold tracking-[-0.025em]">This page was never delivered.</h1>
        <p class="text-lg text-muted">This page doesn't exist, or it moved when the site was rebuilt. Try one of these:</p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/">Home</a>
          <a class="btn btn-secondary" href="/work">Work</a>
          <button type="button" class="btn btn-secondary mono !text-[13px]" data-palette-open>Search with <kbd class="font-[inherit]" data-kbd>⌘K</kbd></button>
        </div>
      </div>
      <div aria-hidden="true" class="mono min-w-0 flex-[1_1_380px] overflow-hidden rounded-lg border border-term-line bg-term-bg text-[13px] leading-[1.7] text-term-ink">
        <div class="flex items-center gap-2.5 border-b border-term-line bg-term-raised px-4 py-2.5 text-xs text-term-muted">
          ROUTER <span class="ml-auto rounded-sm border border-term-amber px-1.5 text-[11px] tracking-[.08em] text-term-amber">NO MATCH</span>
        </div>
        <div class="overflow-x-auto p-4 whitespace-pre">
          <div><span class="text-term-muted">&gt;</span> GET <span class="text-term-amber" id="nf-path">/projects/old-page</span></div>
          <div class="text-term-muted">  attempt 1 … no route · attempt 2 … no route</div>
          <div><span class="text-term-err">  404</span> not found · gave up, no retry will help</div>
          <div class="text-term-muted">  nearest routes: <span class="text-term-ok">/work</span> · <span class="text-term-ok">/writing</span> · <span class="text-term-ok">/about</span></div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById("nf-path").textContent = location.pathname.slice(0, 48);
  </script>
</Base>
