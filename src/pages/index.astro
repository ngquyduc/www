---
import ExpCard from "../components/ExpCard.astro";
import NextCard from "../components/NextCard.astro";
import HeroDemo from "../components/hero/HeroDemo.astro";
import Ledger from "../components/Ledger.astro";
import LiveLabel from "../components/LiveLabel.astro";
import SectionHead from "../components/SectionHead.astro";
import Base from "../layouts/Base.astro";
import { getPosts, getWork, isoDate, readingMinutes, showBuilding } from "../lib/content";
import { site } from "../site";

// Real jobs only, newest first (content order) (§9, §13.4).
const experience = await getWork("experience");
const posts = (await getPosts()).slice(0, 3);
const building = await showBuilding();
---

<Base>
  <section class="hero wrap relative pt-12 md:pt-20" aria-labelledby="pitch">
    <div class="dots hero-dots" aria-hidden="true"></div>
    <div class="relative flex flex-col gap-12">
      <div class="flex max-w-[52rem] flex-col gap-6 pt-3">
        <p class="kicker flex items-center gap-2 text-muted">
          <span class="size-2 rounded-full bg-[#2F9E5B]" aria-hidden="true"></span>Singapore · iOS software engineer
        </p>
        <h1 id="pitch" class="text-display">
          Systems-minded engineer who <span class="ships">ships<svg class="swoosh" viewBox="0 0 200 18" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M3 13 C50 4 120 3 197 9" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"></path></svg></span>.
        </h1>
        <p class="max-w-[36rem] text-lg text-muted">
          I'm Duc. I work on the <span class="mark">instant-messaging SDK</span> behind TikTok chat: on iOS, and more and
          more cross-platform. Before that I shipped at Kovalee, dConstruct Robotics and Vebits.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/work">See my work <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href={site.resumePath} download>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>Résumé (PDF)
          </a>
        </div>
      </div>

      <Ledger />

      <section class="flex flex-col gap-4" aria-labelledby="demo-h">
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-ink pt-3.5">
          <LiveLabel />
          <h2 id="demo-h" class="kicker text-accent">What users see vs what I see</h2>
          <p class="mono text-xs text-subtle">
            Send a text, photo, voice note or video, or press and hold any message to pin it. The right side shows what
            the client does underneath. Simulated, with an invented conversation; not production code.
          </p>
        </div>
        <HeroDemo />
      </section>
    </div>
  </section>

  <section class="wrap below-fold sec" aria-labelledby="exp">
    <SectionHead n="01" id="exp" title="Experience" more={{ href: "/work#experience", label: "All experience" }} />
    <div class="xc-grid mt-7">
      {experience.map((item) => <ExpCard item={item} />)}
    </div>
  </section>

  {
    building && (
      <section class="wrap below-fold sec" aria-labelledby="next">
        <SectionHead n="02" id="next" title="Building next" />
        <div class="mt-7">
          <NextCard />
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="wrap below-fold sec" aria-labelledby="wr">
        <SectionHead n={building ? "03" : "02"} id="wr" title="Latest writing" more={{ href: "/writing", label: "All posts" }} />
        {posts.map((p) => (
          <a class="row-link flex flex-wrap items-baseline gap-x-6 gap-y-1 border-b border-line py-[18px]" href={`/writing/${p.id}`}>
            <time class="w-[110px] shrink-0 text-[13px] text-muted" datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time>
            <span class="min-w-0 flex-[1_1_360px] text-[19px] font-medium">{p.data.title}</span>
            <span class="mono shrink-0 text-[13px] text-muted">{readingMinutes(p.body)} min</span>
          </a>
        ))}
      </section>
    )
  }

  <section class="wrap below-fold sec-last" aria-label="Contact">
    <div class="flex flex-wrap items-end gap-x-10 gap-y-5 border-t border-ink pt-9">
      <p class="contact-line flex-[1_1_520px]">
        Want to talk mobile, SDKs or systems? <span class="text-accent">Email me.</span>
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 text-base">
        <a class="mono break-all" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="mono min-h-11 rounded-[6px] border border-line-strong px-2.5 text-xs text-ink hover:border-ink" data-copy={site.email} data-copy-done="Email address copied" data-copy-fallback={`mailto:${site.email}`} aria-label="Copy email address">Copy</button>
        <a href={site.socials.github.href} rel="me">GitHub</a>
        <a href={site.socials.linkedin.href} rel="me">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Below-the-fold sections skip style, layout and paint until scrolled near (§11 performance). */
  .below-fold {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  /* Section rhythm (§13.4): 112 px between sections, 128 before contact, 64 under 760 px. */
  .sec {
    padding-top: 112px;
  }
  .sec-last {
    padding-top: 128px;
  }
  @media (width < 47.5rem) {
    .sec,
    .sec-last {
      padding-top: 64px;
    }
  }

  /* Dot texture behind the hero: masked to a soft ellipse, top right, 55% (§13.2). */
  .hero-dots {
    position: absolute;
    inset: 0 0 auto;
    height: 560px;
    opacity: 0.55;
    mask-image: radial-gradient(ellipse 60% 70% at 75% 30%, #000 20%, transparent 70%);
    pointer-events: none;
  }

  /* "ships" in accent, with the swoosh drawn in once on load (`swoosh`, §13.2). */
  .ships {
    position: relative;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .swoosh {
    position: absolute;
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    height: 0.24em;
    overflow: visible;
  }
  .swoosh path {
    stroke-dasharray: 1;
    animation: draw 700ms 300ms var(--ease-out) both;
  }

  .contact-line {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  @media (width < 47.5rem) {
    .contact-line {
      font-size: 32px;
    }
  }
</style>
