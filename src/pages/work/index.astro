---
import CourseworkTable from "../../components/CourseworkTable.astro";
import DepthCard from "../../components/DepthCard.astro";
import ExpCard from "../../components/ExpCard.astro";
import FunTile from "../../components/FunTile.astro";
import NextCard from "../../components/NextCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import Base from "../../layouts/Base.astro";
import { getWork, showBuilding } from "../../lib/content";

// §13.4: Experience, Building next, Built for fun. The depth and coursework tiers stay wired up
// for later and render nothing while they're empty (every project in them is hidden today).
const [exp, depth, course, fun] = await Promise.all([
  getWork("experience"),
  getWork("depth"),
  getWork("coursework"),
  getWork("fun"),
]);
const building = await showBuilding();
let n = 0;
const num = () => String(++n).padStart(2, "0");
---

<Base title="Work" description="Shipped work first, then side projects: four jobs with case studies, and a few things built for fun.">
  <section class="wrap relative pt-12 md:pt-[72px]">
    <div class="dots work-dots" aria-hidden="true"></div>
    <div class="relative flex max-w-[46rem] flex-col gap-4">
      <p class="kicker text-muted">Work</p>
      <h1 class="work-h1">Shipped work first. <span class="text-accent">Side projects</span> after.</h1>
      <p class="text-[19px] text-muted">
        Four jobs, each with a case study: what I built, the numbers as they appear on my résumé, and what I'd do
        differently. Then what I'm building now, and a few things I made for fun.
      </p>
    </div>
  </section>

  <section id="experience" class="wrap scroll-mt-6 pt-16 md:pt-[88px]" aria-labelledby="h-exp">
    <SectionHead n={num()} id="h-exp" title="Experience" />
    <div class="xc-grid mt-7">
      {exp.map((e) => <ExpCard item={e} />)}
    </div>
  </section>

  {
    building && (
      <section id="next" class="wrap scroll-mt-6 pt-16 md:pt-28" aria-labelledby="h-next">
        <SectionHead n={num()} id="h-next" title="Building next" />
        <div class="mt-7">
          <NextCard />
        </div>
      </section>
    )
  }

  {
    depth.length > 0 && (
      <section id="depth" class="wrap scroll-mt-6 pt-16 md:pt-28" aria-labelledby="h-depth">
        <SectionHead n={num()} id="h-depth" title="Depth projects" />
        <div class="mt-7 grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-4">
          {depth.map((d) => <DepthCard item={d} />)}
        </div>
      </section>
    )
  }

  {
    course.length > 0 && (
      <section id="coursework" class="wrap scroll-mt-6 pt-16 md:pt-28" aria-labelledby="h-course">
        <SectionHead n={num()} id="h-course" title="Coursework" />
        <p class="mt-4 max-w-prose text-sm text-muted">
          Coursework is labelled as coursework and credits the people I built it with. None of it is presented as
          production work.
        </p>
        <div class="mt-4">
          <CourseworkTable items={course} />
        </div>
      </section>
    )
  }

  {
    fun.length > 0 && (
      <section id="fun" class="wrap scroll-mt-6 pt-16 md:pt-28" aria-labelledby="h-fun">
        <SectionHead n={num()} id="h-fun" title="Built for fun" note="Small, unpolished, on GitHub" />
        <div class="fun-grid mt-7">
          {fun.map((f) => <FunTile item={f} />)}
        </div>
      </section>
    )
  }
</Base>

<style>
  .work-dots {
    position: absolute;
    inset: 0 0 auto;
    height: 480px;
    opacity: 0.55;
    mask-image: radial-gradient(ellipse 60% 70% at 75% 30%, #000 20%, transparent 70%);
    pointer-events: none;
  }
  .work-h1 {
    font-size: 60px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .fun-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (width < 47.5rem) {
    .work-h1 {
      font-size: 44px;
    }
    .fun-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
