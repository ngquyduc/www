---
import Base from "../layouts/Base.astro";
import { site } from "../site";

const links = [site.socials.github, site.socials.linkedin, site.socials.instagram];
---

<Base title="Contact" description="Email is the fastest way to reach Duc Nguyen. Also on GitHub, LinkedIn and Instagram.">
  <section class="wrap pt-16 md:pt-24">
    <div class="flex max-w-[46rem] flex-col gap-5">
      <p class="kicker text-muted">Contact</p>
      <h1 class="text-3xl font-bold tracking-[-0.025em]">Email is the fastest way to reach me.</h1>
      <p class="text-lg text-muted">About roles, mobile and SDK work, or anything on this site. I'm in Singapore (UTC+8).</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-b border-t-ink border-b-line py-6">
        <a class="mono text-[22px] font-medium tracking-[-0.01em] break-all md:text-[30px]" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="mono min-h-11 rounded-md border border-line-strong px-3.5 text-[13px] text-ink hover:border-ink active:translate-y-px" data-copy={site.email} data-copy-done="Email address copied to clipboard." data-copy-fallback={`mailto:${site.email}`}>Copy address</button>
      </div>
      <ul>
        {
          links.map((l) => (
            <li>
              <a class="row-link flex items-baseline gap-4 border-b border-line py-4" href={l.href} rel="me">
                <span class="w-[120px] shrink-0 font-semibold">{l.label}</span>
                <span class="mono min-w-0 flex-auto text-sm text-muted">{l.handle}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-2 text-sm text-muted">
        No contact form and no tracking: the address is a plain <code class="mono text-[13px]">mailto:</code> link. Prefer a
        document? <a href={site.resumePath} download>Download my résumé (PDF)</a>.
      </p>
    </div>
  </section>
</Base>
