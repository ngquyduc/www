---
import { render } from "astro:content";
import Callout from "../../components/Callout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Figure from "../../components/Figure.astro";
import Placeholder from "../../components/Placeholder.astro";
import PostLayout from "../../layouts/Post.astro";
import { getPosts, type Post, readingMinutes } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  entry: Post;
  older?: Post;
  newer?: Post;
}
const { entry, older, newer } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout entry={entry} minutes={readingMinutes(entry.body)} older={older} newer={newer}>
  <Content components={{ Placeholder, Callout, Figure, pre: CodeBlock }} />
</PostLayout>
