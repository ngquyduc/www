{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm astro preview --port 4330 --ignore-lock",
      "startServerReadyPattern": "ready in",
      "url": [
        "http://localhost:4330/",
        "http://localhost:4330/work",
        "http://localhost:4330/work/matching-engine",
        "http://localhost:4330/work/dconstruct",
        "http://localhost:4330/writing",
        "http://localhost:4330/about",
        "http://localhost:4330/contact"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--headless=new --no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
